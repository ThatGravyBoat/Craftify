        "craftify.mixins.json"
    ],
    "license": "All Rights Reserved",
    "environment": "client",
    "depends": {
        "fabric-language-kotlin": ">=1.6.4+kotlin.1.5.30",
        "fabricloader": ">=0.12.0",
        "fabric-api": "*",
        "minecraft": "26.1.x"
    }
}