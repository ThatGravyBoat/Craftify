        "issues": "https://github.com/ThatGravyBoat/Craftify/issues"
    },
    "entrypoints": {
        "client": [
            {
                "adapter": "kotlin",
                "value": "tech.thatgravyboat.craftify.Craftify"
            }
        ]
    },
