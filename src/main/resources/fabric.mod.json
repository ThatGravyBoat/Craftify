{
    "schemaVersion": 1,
    "id": "craftify",
    "name": "Craftify",
    "version": "${version}",
    "description": "Music controls in minecraft!",
    "authors": [
        "ThatGravyBoat"
    ],
    "contact": {
        "homepage": "https://modrinth.com/mod/craftify",
